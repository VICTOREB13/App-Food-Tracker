<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wide_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:baselineAligned="false">

    <!-- Left Column: Calories Ring / Summary Box -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.05"
        android:orientation="vertical"
        android:background="@drawable/widget_surface_box"
        android:padding="10dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CALORÍAS"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/widget_accent" />

        <TextView
            android:id="@+id/widget_calories_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="---"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="kcal restantes"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/widget_calories_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0 / 2000 kcal"
            android:textSize="9sp"
            android:textColor="@color/widget_text_muted" />
    </LinearLayout>

    <!-- Center Column: Macronutrients Breakdown -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:background="@drawable/widget_surface_box"
        android:padding="10dp"
        android:gravity="center_vertical">

        <!-- Protein Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROT"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/widget_protein" />
            <TextView
                android:id="@+id/widget_protein_val"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0g (0g rest)"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/widget_border" />

        <!-- Carbs Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CARB"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/widget_carbs" />
            <TextView
                android:id="@+id/widget_carbs_val"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0g (0g rest)"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/widget_border" />

        <!-- Fat Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GRASAS"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/widget_fat" />
            <TextView
                android:id="@+id/widget_fat_val"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="0g (0g rest)"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Column: Interactive Quick Action Buttons -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Button 1: Escanear Comida (Cámara IA) -->
        <LinearLayout
            android:id="@+id/widget_btn_scan_food"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_button_accent"
            android:gravity="center"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 Cámara IA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escanear"
                android:textSize="9sp"
                android:textColor="#FEE2E2" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="6dp" />

        <!-- Button 2: Código de Barras -->
        <LinearLayout
            android:id="@+id/widget_btn_scan_barcode"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_button_secondary"
            android:gravity="center"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 Código"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="de Barras"
                android:textSize="9sp"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
