<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:gravity="center">

    <!-- Header / Label Nothing OS Tracking -->
    <TextView
        android:id="@+id/widget_label_calories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_label_calories"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:textColor="@color/widget_accent" />

    <!-- Hero Ring Gauge Container -->
    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_circle_gauge">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Calories Left -->
            <TextView
                android:id="@+id/widget_calories_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="---"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary" />

            <!-- Subtitle: Restantes / Left -->
            <TextView
                android:id="@+id/widget_calories_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_calories_subtitle"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="@color/widget_text_secondary" />
        </LinearLayout>
    </FrameLayout>

    <!-- Consumed vs Target Summary -->
    <TextView
        android:id="@+id/widget_calories_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="0 / 2000 kcal"
        android:textSize="9sp"
        android:textColor="@color/widget_text_muted" />

    <!-- Subtle Quick Action Pill Button -->
    <LinearLayout
        android:id="@+id/widget_btn_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/widget_pill_button"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp">

        <TextView
            android:id="@+id/widget_btn_add_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_action_add"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="@color/widget_text_primary" />
    </LinearLayout>

</LinearLayout>
